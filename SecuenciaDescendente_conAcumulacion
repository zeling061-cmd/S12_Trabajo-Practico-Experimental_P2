Algoritmo SecuenciaDescendenteAcumulacion
    Definir i, sumaPares, sumaImpares Como Entero
    
	//ambos acumuladores deben estar en 0
    sumaPares <- 0
    sumaImpares <- 0
    
    Escribir "Secuencia descendente del 20 al 1:"
    
    Para i <- 20 Hasta 1 Con Paso -1 Hacer
        Escribir i
        
		//En cada vuelta se evalua i MOD 2=0
        Si (i MOD 2 = 0) Entonces
            sumaPares <- sumaPares + i
        SiNo
            sumaImpares <- sumaImpares + i
        FinSi
    FinPara
    
    Escribir "Suma total de números pares: ", sumaPares
    Escribir "Suma total de números impares: ", sumaImpares
FinAlgoritmo
