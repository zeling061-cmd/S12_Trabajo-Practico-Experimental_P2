Algoritmo MultiplosDeTres
    Definir i, contador Como Entero
    
	//lleva la cuenta de los multiplos que se van encontrando
    contador <- 0
    
    Escribir "Números múltiplos de 3 entre 1 y 50:"
    
    Para i <- 1 Hasta 50 Con Paso 1 Hacer
		//comprobar si el residuo de i dividido para 3 es 0
        Si (i MOD 3 = 0) Entonces
            Escribir i
            contador <- contador + 1
        FinSi
    FinPara
    
    Escribir "Cantidad total de múltiplos de 3 encontrados: ", contador
FinAlgoritmo
