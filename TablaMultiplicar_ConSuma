Algoritmo TablaMultiplicarConSuma
	Definir num, inicio, end, i, resultado, sumaResultados Como Entero
	// para evitar valores indefinidos se pone en 0
	sumaResultados <- 0
	Escribir 'Ingrese el número entero para la tabla de multiplicar:'
	Leer num
	Escribir 'Ingrese el número de inicio de la tabla:'
	Leer inicio
	Escribir 'Ingrese el número final de la tabla:'
	Leer end
	Escribir 'Tabla de multiplicar del ', num, ' (desde ', inicio, ' hasta ', end, '):'
	Para i<-inicio Hasta end Con Paso 1 Hacer
		// Calcular el producto
		resultado <- num*i
		Escribir num, ' x ', i, ' = ', resultado
		// se suma el producto al acumulador
		sumaResultados <- sumaResultados+resultado
	FinPara
	Escribir 'La suma de todos los resultados obtenidos es: ', sumaResultados
FinAlgoritmo
